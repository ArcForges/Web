<Router AppAssembly="typeof(ArcForges.Web.Operations.App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(ArcForges.Web.Operations.Layout.OperationsLayout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(ArcForges.Web.Operations.Layout.OperationsLayout)">
            <section class="example">
                <h1>Page not found.</h1>
                <p class="hero-copy">The operations console has a single shell page in this build.</p>
            </section>
        </LayoutView>
    </NotFound>
</Router>
