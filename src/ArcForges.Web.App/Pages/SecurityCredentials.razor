@using ArcForges.Contracts.PublicApi.V1
@using ArcForges.Web.App.Dashboard
@using ArcForges.Web.App.Layout
@implements IDisposable
@inject IDashboardSecurity Center
@inject NavigationManager Navigation

<section class="dashboard-panel" aria-labelledby="dashboard-security-credentials">
    <header class="dashboard-panel-header">
        <div>
            <h2 id="dashboard-security-credentials">Sign-in methods</h2>
            <p class="dashboard-muted">Credential activity reported by this Center.</p>
        </div>
        @if (CanOpenPasskeys)
        {
            <a class="dashboard-link" href="@PasskeysPath" @onclick="OpenPasskeys" @onclick:preventDefault>Manage passkeys on this Center</a>
        }
    </header>
    @if (_reading)
    {
        <p class="dashboard-panel-copy" role="status">Reading sign-in methods…</p>
    }
    @if (_failure is { } failure)
    {
        <p class="dashboard-notice" role="alert">@failure.Message</p>
    }
    @if (_page is { } page)
    {
        @if (page.Items.Count == 0)
        {
            <p class="dashboard-panel-copy">No sign-in methods on this page.</p>
        }
        else
        {
            <div class="dashboard-table-wrap" role="region" aria-label="Sign-in methods" tabindex="0">
                <table class="dashboard-table" aria-label="Sign-in methods">
                    <thead>
                        <tr><th scope="col">Method</th><th scope="col" class="dashboard-table-extra">Added</th><th scope="col">Last used</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in page.Items)
                        {
                            <tr @key="item.CredentialId">
                                <td>
                                    <strong>@(string.IsNullOrWhiteSpace(item.DisplayName) ? item.Kind : item.DisplayName)</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.DisplayName))
                                    {
                                        <small class="dashboard-muted">@item.Kind</small>
                                    }
                                </td>
                                <td class="dashboard-table-extra"><DashboardTime Value="@RunPresentation.ReadTime(item.CreatedAt)" /></td>
                                <td><DashboardTime Value="@RunPresentation.ReadTime(item.LastUsedAt)" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <div class="dashboard-panel-footer dashboard-actions">
            <button type="button" class="dashboard-button dashboard-button-quiet" disabled="@_reading" @onclick="RefreshAsync">Refresh</button>
            @if (_cursor is not null)
            {
                <button type="button" class="dashboard-button dashboard-button-quiet" disabled="@_reading" @onclick="ReadFirstAsync">First page</button>
            }
            @if (page.Page is { HasMore: true, NextCursor.Length: > 0 })
            {
                <button type="button" class="dashboard-button dashboard-button-quiet" disabled="@(_reading || _failure is not null)" @onclick="ReadNextAsync">Next page</button>
            }
        </div>
    }
    else if (!_reading && _failure is not null)
    {
        <div class="dashboard-panel-footer">
            <button type="button" class="dashboard-button dashboard-button-quiet" @onclick="RefreshAsync">Refresh</button>
        </div>
    }
</section>

@code {
    [CascadingParameter]
    private DashboardAccess Access { get; set; } = default!;

    private const string PasskeysPath = "/api/account/passkeys";
    private readonly CancellationTokenSource _lifetime = new();
    private IdentityServiceListAuthIdentitiesValue? _page;
    private DashboardApiException? _failure;
    private string? _cursor;
    private bool _reading;
    private bool _disposed;

    private bool CanOpenPasskeys => !_disposed && Access is { Session.Authenticated: true } &&
        !Access.Cancellation.IsCancellationRequested;

    protected override Task OnInitializedAsync() => ReadAsync(null);
    private Task RefreshAsync() => ReadAsync(_cursor);
    private Task ReadFirstAsync() => ReadAsync(null);
    private Task ReadNextAsync() => _page?.Page?.NextCursor is { Length: > 0 } next ? ReadAsync(next) : Task.CompletedTask;
    private void OpenPasskeys()
    {
        if (CanOpenPasskeys)
            Navigation.NavigateTo(PasskeysPath, forceLoad: true);
    }

    private async Task ReadAsync(string? cursor)
    {
        if (_reading || _disposed)
            return;

        _reading = true;
        try
        {
            var page = await Center.ListCredentialsAsync(cursor, _lifetime.Token);
            if (!_disposed)
            {
                _page = page;
                _cursor = cursor;
                _failure = null;
            }
        }
        catch (DashboardApiException failure) when (!_disposed)
        {
            _failure = failure;
            if (failure.Failure is DashboardFailure.Unauthenticated or DashboardFailure.Forbidden)
                _page = null;
            if (failure.Failure == DashboardFailure.Unauthenticated)
                await Access.ExpireAsync();
        }
        catch (DashboardApiException) when (_disposed)
        {
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        finally
        {
            _reading = false;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
