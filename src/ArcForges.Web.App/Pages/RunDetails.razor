@page "/devices/{DeviceId:guid}/runs/{RunId:guid}"

<PageTitle>Run details | ArcForges</PageTitle>

<section class="dashboard-intro">
    <div>
        <a class="dashboard-link" href="@($"/devices/{DeviceId:D}/runs")">Runs</a>
        <h1>Run details</h1>
    </div>
</section>

<DashboardWorkScopeView DeviceId="DeviceId" Context="target">
    @if (target.SandboxId is not null)
    {
        <RunDetailsView @key="(target, RunId)" DeviceId="DeviceId" RunId="RunId" Target="target" />
    }
    else
    {
        <p class="dashboard-panel-copy">Select the authorized Sandbox for this Run.</p>
    }
</DashboardWorkScopeView>

@code {
    [Parameter]
    public Guid DeviceId { get; set; }

    [Parameter]
    public Guid RunId { get; set; }
}
