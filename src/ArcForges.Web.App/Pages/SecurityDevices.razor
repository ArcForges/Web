@using ArcForges.Web.App.Dashboard
@using ArcForges.Web.App.Layout
@implements IDisposable
@inject IDashboardCenter Center

<section class="dashboard-panel" aria-labelledby="dashboard-security-devices">
    <header class="dashboard-panel-header">
        <div>
            <h2 id="dashboard-security-devices">Enrolled devices</h2>
            @if (_observed is { } observed)
            {
                <p class="dashboard-muted">Observed <DashboardTime Value="observed" />.</p>
            }
        </div>
        <button type="button" class="dashboard-button dashboard-button-quiet" disabled="@_reading" @onclick="RefreshAsync">Refresh</button>
    </header>
    @if (_reading)
    {
        <p class="dashboard-panel-copy" role="status">Reading enrolled devices…</p>
    }
    @if (_failure is { } failure)
    {
        <p class="dashboard-notice" role="alert">@failure.Message</p>
    }
    @if (_page is { } page)
    {
        @if (page.Devices.Count == 0)
        {
            <p class="dashboard-panel-copy">No devices on this page.</p>
        }
        else
        {
            <div class="dashboard-table-wrap" role="region" aria-label="Enrolled devices" tabindex="0">
                <table class="dashboard-table" aria-label="Enrolled devices">
                    <thead>
                        <tr><th scope="col">Device</th><th scope="col">Presence</th><th scope="col" class="dashboard-table-extra">Last seen</th><th scope="col">Local access</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var device in page.Devices)
                        {
                            <tr @key="device.Id">
                                <td>
                                    <a class="dashboard-link dashboard-device-link" href="@($"/devices/{device.Id:D}")">@DeviceName(device)</a>
                                    <small class="dashboard-muted">@device.Platform</small>
                                </td>
                                <td><DevicePresence Presence="device.Presence" /></td>
                                <td class="dashboard-table-extra"><DashboardTime Value="device.LastSeenAt" /></td>
                                <td>
                                    @if (device.Presence == DashboardDevicePresence.Online)
                                    {
                                        <a class="dashboard-link" href="@($"/security?device={device.Id:D}")"
                                           aria-current="@(SelectedDeviceId == device.Id ? "true" : null)">View grant</a>
                                    }
                                    else
                                    {
                                        <span class="dashboard-muted">Unavailable</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <p class="dashboard-panel-copy dashboard-muted">Open a device to review or revoke its enrollment. For a new enrollment, verify the Node key fingerprint against the value shown by <code>arcforges center flow</code> on that device.</p>
        @if (_cursor is not null || page.NextCursor is not null)
        {
            <div class="dashboard-panel-footer dashboard-actions">
                <button type="button" class="dashboard-button dashboard-button-quiet" disabled="@(_reading || _cursor is null)" @onclick="ReadFirstAsync">First page</button>
                <button type="button" class="dashboard-button dashboard-button-quiet" disabled="@(_reading || _failure is not null || page.NextCursor is null)" @onclick="ReadNextAsync">Next page</button>
            </div>
        }
    }
</section>

@code {
    [CascadingParameter]
    private DashboardAccess Access { get; set; } = default!;

    [Parameter]
    public Guid? SelectedDeviceId { get; set; }

    [Inject]
    private TimeProvider Clock { get; set; } = default!;

    private readonly CancellationTokenSource _lifetime = new();
    private DashboardDevicePage? _page;
    private DashboardApiException? _failure;
    private DateTimeOffset? _observed;
    private string? _cursor;
    private bool _reading;
    private bool _disposed;

    protected override Task OnInitializedAsync() => ReadAsync(null);
    private Task RefreshAsync() => ReadAsync(_cursor);
    private Task ReadFirstAsync() => ReadAsync(null);
    private Task ReadNextAsync() => _page?.NextCursor is { } next ? ReadAsync(next) : Task.CompletedTask;

    private async Task ReadAsync(string? cursor)
    {
        if (_reading || _disposed)
            return;

        _reading = true;
        try
        {
            var page = await Center.ListDevicesAsync(cursor, _lifetime.Token);
            if (!_disposed)
            {
                _page = page;
                _cursor = cursor;
                _failure = null;
                _observed = Clock.GetUtcNow();
            }
        }
        catch (DashboardApiException failure) when (!_disposed)
        {
            _failure = failure;
            if (failure.Failure is DashboardFailure.Unauthenticated or DashboardFailure.Forbidden)
                _page = null;
            if (failure.Failure == DashboardFailure.Unauthenticated)
                await Access.ExpireAsync();
        }
        catch (DashboardApiException) when (_disposed)
        {
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        finally
        {
            _reading = false;
        }
    }

    private static string DeviceName(DashboardDevice device) => string.IsNullOrWhiteSpace(device.Name) ? $"Device {device.Id:D}" : device.Name;

    public void Dispose()
    {
        _disposed = true;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
