@using ArcForges.Contracts.Foundation.V1
@using ArcForges.Contracts.PublicApi.V1
@using ArcForges.Web.App.Dashboard
@using ArcForges.Web.App.Layout
@implements IDisposable
@inject IDashboardSecurity Center
@inject TimeProvider Clock

<section class="dashboard-panel" aria-labelledby="dashboard-security-sessions">
    <header class="dashboard-panel-header">
        <div>
            <h2 id="dashboard-security-sessions" tabindex="-1" @ref="_sessionsHeading">Sessions</h2>
            @if (_observed is { } observed)
            {
                <p class="dashboard-muted">Observed <DashboardTime Value="observed" />. @(_failure is null ? null : "The list may be stale.")</p>
            }
        </div>
        <button type="button" class="dashboard-button dashboard-button-quiet" disabled="@_reading" @onclick="RefreshAsync">Refresh</button>
    </header>
    @if (_reading)
    {
        <p class="dashboard-panel-copy" role="status">Reading sessions…</p>
    }
    @if (_failure is { } failure)
    {
        <p class="dashboard-notice" role="alert">@failure.Message</p>
    }
    @if (_mutationFailure is { } mutationFailure)
    {
        <p class="dashboard-notice" role="alert">@mutationFailure.Message</p>
        @if (mutationFailure.CorrelationId is Guid reference)
        {
            <p class="dashboard-panel-copy">Reference <code>@reference</code></p>
        }
    }
    @if (_notice is { } notice)
    {
        <p class="dashboard-panel-copy" role="status">@notice</p>
    }
    @if (_page is { } page)
    {
        @if (!VisibleSessions(page).Any())
        {
            <p class="dashboard-panel-copy">No active sessions on this page.</p>
        }
        else
        {
            <div class="dashboard-table-wrap" role="region" aria-label="Active sessions" tabindex="0">
                <table class="dashboard-table" aria-label="Active sessions">
                    <thead>
                        <tr><th scope="col">Session</th><th scope="col" class="dashboard-table-extra">Last used</th><th scope="col">Expires</th><th scope="col">Access</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var session in VisibleSessions(page))
                        {
                            @if (RunPresentation.ReadId(session.SessionId) is Guid id)
                            {
                                <tr @key="id">
                                    <td>
                                        <strong>@SessionLabel(session)</strong>
                                        @if (IsCurrent(session, id))
                                        {
                                            <small class="dashboard-muted">This session</small>
                                        }
                                    </td>
                                    <td class="dashboard-table-extra"><DashboardTime Value="@RunPresentation.ReadTime(session.LastUsedAt)" /></td>
                                    <td><DashboardTime Value="@RunPresentation.ReadTime(session.ExpiresAt)" /></td>
                                    <td>
                                        @if (IsCurrent(session, id))
                                        {
                                            <span class="dashboard-muted">Use Sign out</span>
                                        }
                                        else
                                        {
                                            <button type="button" class="dashboard-button dashboard-button-danger"
                                                    aria-disabled="@(!CanRevoke(session, id) ? "true" : "false")"
                                                    aria-haspopup="dialog" aria-controls="@($"security-revoke-session-{id:N}")"
                                                    @onfocus="() => FocusSessionAction(id)" @onblur="() => BlurSessionAction(id)"
                                                    command="@(CanRevoke(session, id) ? "show-modal" : null)" commandfor="@($"security-revoke-session-{id:N}")">
                                                @(Access.SecuritySessionRevocations.ContainsKey(id) ? "Revocation pending" : "Revoke session")
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            @foreach (var session in VisibleSessions(page))
            {
                @if (RunPresentation.ReadId(session.SessionId) is Guid id && !IsCurrent(session, id))
                {
                    <dialog @key="@($"session-dialog-{id:N}")" id="@($"security-revoke-session-{id:N}")" class="dashboard-dialog"
                            aria-labelledby="@($"security-revoke-session-title-{id:N}")"
                            aria-describedby="@($"security-revoke-session-description-{id:N}")" closedby="closerequest">
                        <h2 id="@($"security-revoke-session-title-{id:N}")">Revoke this session?</h2>
                        <p id="@($"security-revoke-session-description-{id:N}")">End the selected @SessionLabel(session) session. Confirm this action with your passkey.</p>
                        <dl class="dashboard-dialog-facts">
                            <dt>Session ID</dt><dd><code>@id</code></dd>
                            <dt>Last used</dt><dd><DashboardTime Value="@RunPresentation.ReadTime(session.LastUsedAt)" /></dd>
                        </dl>
                        <form method="dialog" class="dashboard-actions">
                            <button type="submit" value="cancel" class="dashboard-button dashboard-button-quiet" autofocus>Cancel</button>
                            <button type="submit" value="revoke" class="dashboard-button dashboard-button-danger-solid"
                                    @onfocus="() => FocusSessionAction(id)" @onblur="() => BlurSessionAction(id)"
                                    disabled="@(!CanRevoke(session, id))" @onclick="() => RevokeAsync(session, id)">Confirm revocation</button>
                        </form>
                    </dialog>
                }
            }
        }
        @if (_cursor is not null || page.Page is { HasMore: true, NextCursor.Length: > 0 })
        {
            <div class="dashboard-panel-footer dashboard-actions">
                <button type="button" class="dashboard-button dashboard-button-quiet" disabled="@(_reading || _cursor is null)" @onclick="ReadFirstAsync">First page</button>
                <button type="button" class="dashboard-button dashboard-button-quiet"
                        disabled="@(_reading || _failure is not null || page.Page is not { HasMore: true, NextCursor.Length: > 0 })"
                        @onclick="ReadNextAsync">Next page</button>
            </div>
        }
    }
    @foreach (var (sessionId, pending) in Access.SecuritySessionRevocations.Where(item => item.Value.ConfirmedRevision is null))
    {
        <div class="dashboard-panel-copy" role="status" @key="sessionId">
            @if (pending.Sending)
            {
                <p>Waiting for the Center to confirm session revocation.</p>
            }
            else
            {
                <p><strong>Session revocation result unknown.</strong> Refresh to see current access. An absent session can also have expired.</p>
            }
            <p>Session <code>@sessionId</code> · Command <code>@pending.CommandId</code></p>
            @if (pending.Failure?.CorrelationId is Guid reference)
            {
                <p>Reference <code>@reference</code></p>
            }
        </div>
    }
</section>

@code {
    [CascadingParameter]
    private DashboardAccess Access { get; set; } = default!;

    private readonly CancellationTokenSource _lifetime = new();
    private IdentityServiceListSessionsValue? _page;
    private DashboardApiException? _failure;
    private DashboardApiException? _mutationFailure;
    private DateTimeOffset? _observed;
    private string? _cursor;
    private string? _notice;
    private ElementReference _sessionsHeading;
    private Guid? _focusedSessionAction;
    private bool _focusAfterRevocation;
    private bool _reading;
    private bool _disposed;

    protected override Task OnInitializedAsync()
    {
        Access.SecurityRevocationsChanged += RevocationsChanged;
        return ReadAsync(null);
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusAfterRevocation || _disposed || Access.Cancellation.IsCancellationRequested)
            return Task.CompletedTask;
        _focusAfterRevocation = false;
        _focusedSessionAction = null;
        return _sessionsHeading.FocusAsync().AsTask();
    }

    private Task RefreshAsync() => ReadAsync(_cursor);
    private Task ReadFirstAsync() => ReadAsync(null);
    private Task ReadNextAsync() => _page?.Page?.NextCursor is { Length: > 0 } next ? ReadAsync(next) : Task.CompletedTask;

    private IEnumerable<SessionSummary> VisibleSessions(IdentityServiceListSessionsValue page) =>
        page.Sessions.Where(session => RunPresentation.ReadId(session.SessionId) is not Guid id ||
            !Access.SecuritySessionRevocations.TryGetValue(id, out var pending) || pending.ConfirmedRevision is null);

    private bool IsCurrent(SessionSummary session, Guid id) => session.Current || id == Access.Session.SessionId;

    private bool CanRevoke(SessionSummary session, Guid id) => !_reading && !_disposed && _failure is null &&
        !IsCurrent(session, id) && _page?.Sessions.Any(item => ReferenceEquals(item, session)) == true &&
        !Access.SecuritySessionRevocations.ContainsKey(id);

    private async Task ReadAsync(string? cursor)
    {
        if (_reading || _disposed)
            return;

        _reading = true;
        try
        {
            var page = await Center.ListSessionsAsync(cursor, _lifetime.Token);
            if (!_disposed)
            {
                _page = page;
                _cursor = cursor;
                _failure = null;
                _observed = Clock.GetUtcNow();
            }
        }
        catch (DashboardApiException failure) when (!_disposed)
        {
            _failure = failure;
            if (failure.Failure is DashboardFailure.Unauthenticated or DashboardFailure.Forbidden)
            {
                _page = null;
                _observed = null;
            }
            if (failure.Failure == DashboardFailure.Unauthenticated)
                await Access.ExpireAsync();
        }
        catch (DashboardApiException) when (_disposed)
        {
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        finally
        {
            _reading = false;
        }
    }

    private async Task RevokeAsync(SessionSummary session, Guid id)
    {
        if (!CanRevoke(session, id))
            return;

        var access = Access;
        var pending = new PendingSecuritySessionRevocation(Guid.NewGuid());
        if (!access.SecuritySessionRevocations.TryAdd(id, pending))
            return;

        _notice = null;
        _mutationFailure = null;
        access.NotifySecurityRevocationsChanged();
        try
        {
            var receipt = await Center.RevokeSessionAsync(id, pending.CommandId, access.Cancellation);
            if (RunPresentation.ReadId(receipt.CommandId) != pending.CommandId || receipt.Effect != EffectCertainty.Happened ||
                receipt.ResultRevision is not { Value: > 0 })
                throw new DashboardApiException(DashboardFailure.Uncertain);

            pending.ConfirmedRevision = receipt.ResultRevision.Value;
            if (!_disposed)
                _notice = "The Center confirmed session revocation.";
        }
        catch (DashboardApiException failure)
        {
            pending.Failure = failure;
            if (failure.Failure != DashboardFailure.Uncertain)
                access.SecuritySessionRevocations.Remove(id);
            if (!_disposed)
                _mutationFailure = failure;
            if (failure.Failure == DashboardFailure.Unauthenticated)
                await access.ExpireAsync();
        }
        catch (OperationCanceledException) when (access.Cancellation.IsCancellationRequested)
        {
        }
        finally
        {
            pending.Sending = false;
            access.NotifySecurityRevocationsChanged();
        }
    }

    private void RevocationsChanged()
    {
        if (!_disposed)
        {
            _ = InvokeAsync(() =>
            {
                if (_disposed)
                    return;
                if (_focusedSessionAction is Guid id &&
                    Access.SecuritySessionRevocations.TryGetValue(id, out var pending) && pending.ConfirmedRevision is not null)
                    _focusAfterRevocation = true;
                StateHasChanged();
            });
        }
    }

    private void FocusSessionAction(Guid id) => _focusedSessionAction = id;

    private void BlurSessionAction(Guid id)
    {
        if (_focusedSessionAction == id)
            _focusedSessionAction = null;
    }

    private static string SessionLabel(SessionSummary session) =>
        string.IsNullOrWhiteSpace(session.Product) ? "ArcForges" : session.Product;

    public void Dispose()
    {
        _disposed = true;
        Access.SecurityRevocationsChanged -= RevocationsChanged;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
