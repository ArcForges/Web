<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <PropertyGroup>
    <RunAOTCompilation>false</RunAOTCompilation>
    <TrimMode>full</TrimMode>
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <!-- The Dashboard reports bounded typed outcomes. Keep raw protobuf diagnostic formatting out of its WASM publish. -->
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileDirectory)ProtobufBrowserDiagnostics.xml</MSBuildAllProjects>
    <_ExtraTrimmerArgs>$(_ExtraTrimmerArgs) --substitutions &quot;$(MSBuildThisFileDirectory)ProtobufBrowserDiagnostics.xml&quot;</_ExtraTrimmerArgs>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ArcForges.Contracts.Management.V2" />
    <PackageReference Include="ArcForges.Contracts.Sandbox.V2" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Net.Client.Web" />
  </ItemGroup>
  <ItemGroup>
    <!-- AFV2-ENV-01: exact SDK 11 browser-wasm tool pack; the runtime pack is selected by the same SDK/workload set. -->
    <PackageDownload Include="Microsoft.NET.Runtime.WebAssembly.Sdk" Version="[11.0.0]" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ArcForges.Web.Ui/ArcForges.Web.Ui.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <LicenceBoundary>AGPL</LicenceBoundary>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
  <!-- Framework JavaScript source maps are development diagnostics, not profile runtime resources. .NET 11 adds
       this map to the package asset manifest; keep it available to builds and exclude it from published profiles. -->
  <Target Name="ArcForgesKeepFrameworkSourceMapBuildOnly" BeforeTargets="GenerateStaticWebAssetsPublishManifest">
    <ItemGroup>
      <StaticWebAsset Update="@(StaticWebAsset)"
                      Condition="$([System.String]::Copy('%(StaticWebAsset.Identity)').EndsWith('blazor.webassembly.js.map')) Or $([System.String]::Copy('%(StaticWebAsset.RelatedAsset)').EndsWith('blazor.webassembly.js.map'))">
        <AssetKind>Build</AssetKind>
        <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      </StaticWebAsset>
    </ItemGroup>
  </Target>
</Project>
