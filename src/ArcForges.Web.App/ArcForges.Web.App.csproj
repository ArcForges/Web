  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ArcForges.Web.Ui/ArcForges.Web.Ui.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <LicenceBoundary>AGPL</LicenceBoundary>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
