  <PropertyGroup>
    <RunAOTCompilation>false</RunAOTCompilation>
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Net.Client.Web" />
  </ItemGroup>
  <ItemGroup>
    <!-- WEB.40 section 10 browser-wasm admission (receipt web-40-admission-r2.json): the WebAssembly SDK pack at the SDK 10.0.401 bundled runtime version 10.0.12. The Mono browser-wasm runtime pack is added implicitly by the SDK at the same version. -->
