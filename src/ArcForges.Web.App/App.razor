@using System.Diagnostics.CodeAnalysis
@using ArcForges.Web.App.Layout
@using ArcForges.Web.App.Pages

<Router AppAssembly="DashboardAssembly()">
    <Found Context="routeData">
        <DashboardLayout>
            <Body>
                <RouteView RouteData="routeData" />
            </Body>
        </DashboardLayout>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <DashboardLayout>
            <Body>
                <section class="dashboard-intro">
                    <h1>Page not found</h1>
                    <a class="dashboard-link" href="/overview">Go to Overview</a>
                </section>
            </Body>
        </DashboardLayout>
    </NotFound>
</Router>

@code {
    private const DynamicallyAccessedMemberTypes RoutedComponentMembers =
        DynamicallyAccessedMemberTypes.PublicParameterlessConstructor |
        DynamicallyAccessedMemberTypes.PublicProperties |
        DynamicallyAccessedMemberTypes.NonPublicProperties;

    // Router discovers the pages through their route attributes.
    [DynamicDependency(RoutedComponentMembers, typeof(Overview))]
    [DynamicDependency(RoutedComponentMembers, typeof(Devices))]
    [DynamicDependency(RoutedComponentMembers, typeof(DeviceDetails))]
    [DynamicDependency(RoutedComponentMembers, typeof(Sandboxes))]
    [DynamicDependency(RoutedComponentMembers, typeof(SandboxDetails))]
    [DynamicDependency(RoutedComponentMembers, typeof(Runs))]
    [DynamicDependency(RoutedComponentMembers, typeof(RunDetails))]
    [DynamicDependency(RoutedComponentMembers, typeof(Resources))]
    [DynamicDependency(RoutedComponentMembers, typeof(Security))]
    [DynamicDependency(RoutedComponentMembers, typeof(Account))]
    [DynamicDependency(RoutedComponentMembers, typeof(Subscription))]
    private static System.Reflection.Assembly DashboardAssembly() => typeof(App).Assembly;
}
