<Router AppAssembly="typeof(ArcForges.Web.App.App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(ArcForges.Web.App.Layout.DashboardLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(ArcForges.Web.App.Layout.DashboardLayout)">
            <section class="dashboard-intro">
                <h1>Page not found</h1>
                <a class="dashboard-link" href="/overview">Go to Overview</a>
            </section>
        </LayoutView>
    </NotFound>
</Router>
