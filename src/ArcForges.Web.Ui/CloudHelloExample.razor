@implements IDisposable
<section class="example"><a class="back-link" href="/hello/">← Back to your hello</a><p class="eyebrow">Connection example</p><h1>A hello, <em>from the server.</em></h1><p class="hero-copy">Send a fixed “ArcForges” greeting to check the server connection. Your name from the local example stays in your browser. Nothing is sent until you choose to connect.</p><Button type="button" disabled="@(!_ready || _state == ConnectionState.Pending)" @onclick="ConnectAsync">@ButtonLabel</Button><noscript><p class="no-script">Enable JavaScript to check the server connection.</p></noscript><div class="greeting" role="@RegionRole" aria-live="polite" aria-atomic="true"><span class="greeting-label">Server response</span><p>@Message</p></div></section>

@code {
    private enum ConnectionState
    {
        Idle,
        Pending,
        Success,
        Error,
    }

    private bool _ready;
    private ConnectionState _state = ConnectionState.Idle;
    private string _reply = string.Empty;
    private CancellationTokenSource? _active;

    /// <summary>
    /// The check that the host supplies (the App profile calls the server; the static Site supplies none, so the
    /// control stays disabled, as the no-script page requires).
    /// </summary>
    [Parameter]
    public Func<CancellationToken, Task<string>>? CheckConnection { get; set; }

    private string ButtonLabel => _state == ConnectionState.Pending ? "Connecting…" : "Check connection";

    private string RegionRole => _state == ConnectionState.Error ? "alert" : "status";

    private string Message => _state switch
    {
        ConnectionState.Idle => "No request sent yet.",
        ConnectionState.Pending => "Contacting the server…",
        ConnectionState.Success => _reply,
        _ => "The server is unavailable or returned an unexpected response. Try again later.",
    };

    /// <summary>Enables the control after the first interactive render, as the React example did after mount.</summary>
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && !_ready)
        {
            _ready = true;
            StateHasChanged();
        }
    }

    /// <summary>Cancels a check that is still running when the page is left, as the React cleanup did.</summary>
    public void Dispose() => _active?.Cancel();

    private async Task ConnectAsync()
    {
        if (CheckConnection is null || _active is not null)
            return;
        using var controller = new CancellationTokenSource();
        _active = controller;
        _state = ConnectionState.Pending;
        StateHasChanged();
        try
        {
            var message = await CheckConnection(controller.Token);
            if (!controller.IsCancellationRequested)
            {
                _reply = message;
                _state = ConnectionState.Success;
            }
        }
        catch (OperationCanceledException) when (controller.IsCancellationRequested)
        {
            // The component was disposed while the check was running; nothing is shown.
        }
#pragma warning disable CA1031 // Every failure shows the same visitor text, whatever the transport raised.
        catch (Exception)
#pragma warning restore CA1031
        {
            _state = ConnectionState.Error;
        }
        finally
        {
            if (ReferenceEquals(_active, controller))
                _active = null;
        }
    }
}
