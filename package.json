{
  "name": "@arcforges/web-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "ArcForges Web build and deployment tooling: the Cloudflare Worker adapter and the reviewed policy checks",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArcForges/Web.git"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "hooks": "node tooling/project.ts hooks",
    "policy": "node tooling/project.ts policy",
    "build:worker": "node tooling/candidate.ts worker artifacts/inputs/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/worker/*.test.ts tests/provenance/*.test.ts",
    "test:dependencies": "node --test tooling/dependency-policy.test.ts",
    "check:dependencies": "node tooling/dependency-policy.ts",
    "check": "npm run check:dependencies && npm run policy && npm run typecheck && npm run test:dependencies && npm run test",
    "verify:candidate": "node tooling/candidate.ts verify",
    "preview": "wrangler dev --config artifacts/candidate/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --port 4173",
    "deploy": "node tooling/cloudflare.ts deploy",
    "test:live": "node tooling/cloudflare.ts smoke"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "typescript": "7.0.2",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "arcforges": {
    "licenceBoundary": "AGPL"
  }
}
