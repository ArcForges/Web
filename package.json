{
  "name": "@arcforges/web-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "ArcForges Web build and deployment tooling: the Cloudflare Worker adapter and the reviewed policy checks",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArcForges/Web.git"
  },
  "engines": {
    "node": ">=26.13.1 <27",
    "npm": ">=12.2.2 <13"
  },
  "packageManager": "npm@12.2.2",
  "scripts": {
    "policy": "node tooling/project.ts policy",
    "build:worker": "node tooling/candidate.ts worker artifacts/inputs/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/worker/*.test.ts tests/provenance/*.test.ts",
    "test:dependencies": "node --test tooling/dependency-policy.test.ts",
    "check:dependencies": "node tooling/dependency-policy.ts",
    "check": "npm run check:dependencies && npm run policy && npm run typecheck && npm run test:dependencies && npm run test",
    "verify:candidate": "node tooling/candidate.ts verify",
    "preview": "node --import ./tooling/wrangler-init.ts node_modules/wrangler/bin/wrangler.js dev --config artifacts/candidate/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --port 4173",
    "deploy": "node tooling/cloudflare.ts deploy",
    "test:live": "node tooling/cloudflare.ts smoke"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "blake3-wasm": "3.0.0",
    "typescript": "7.0.2",
    "wrangler": "4.162.0"
  },
  "overrides": {
    "@c4312/blake3-internal": "3.0.0",
    "@cloudflare/workerd-darwin-64": "1.20261114.1",
    "@cloudflare/workerd-darwin-arm64": "1.20261114.1",
    "@cloudflare/workerd-linux-64": "1.20261114.1",
    "@cloudflare/workerd-linux-arm64": "1.20261114.1",
    "@cloudflare/workerd-windows-64": "1.20261114.1",
    "@jridgewell/trace-mapping": "0.3.31",
    "@poppinss/dumper": "0.7.0",
    "@sindresorhus/is": "8.1.0",
    "@speed-highlight/core": "2.1.0",
    "blake3-wasm": "3.0.0",
    "cookie": "2.0.2",
    "error-stack-parser-es": "2.0.1",
    "miniflare": "4.20260730.0",
    "mime": "4.1.2",
    "path-to-regexp": "9.0.0",
    "pathe": "2.0.3",
    "sharp": "0.35.5",
    "supports-color": "11.0.0",
    "undici": "8.12.4",
    "undici-types": "8.12.4",
    "unenv": "1.10.0",
    "workerd": "1.20261114.1",
    "ws": "8.23.0",
    "youch": "4.1.1"
  },
  "arcforges": {
    "licenceBoundary": "AGPL"
  }
}
