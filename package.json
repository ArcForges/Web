{
  "name": "@arcforges/web-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "ArcForges Web static Hello World and Cloudflare delivery foundation",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArcForges/Web.git"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/site",
    "packages/ui"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @arcforges/web-site",
    "hooks": "node tooling/project.ts hooks",
    "policy": "node tooling/project.ts policy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "biome lint --error-on-warnings .",
    "typecheck": "npm run typecheck --workspace @arcforges/web-site && tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run policy && npm run format:check && npm run lint && npm run typecheck && npm test",
    "build": "node tooling/project.ts build",
    "verify:candidate": "node tooling/project.ts verify",
    "preview": "wrangler dev --config artifacts/candidate/wrangler.json --local --ip 127.0.0.1 --port 4173",
    "test:e2e": "playwright test",
    "deploy": "node tooling/cloudflare.ts deploy",
    "test:live": "node tooling/cloudflare.ts smoke"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.132.0"
  }
}
